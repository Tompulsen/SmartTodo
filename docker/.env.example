SMARTTODO_IMAGE=ghcr.io/tompulsen/smarttodo:latest
SMARTTODO_DATA_DIR=/www/wwwroot/smarttodo/data
SMARTTODO_CONFIG_DIR=/www/wwwroot/smarttodo/runtime-config
DATABASE_URL=mysql+pymysql://smarttodo:CHANGE_ME@127.0.0.1:3306/smarttodo?charset=utf8mb4
SMARTTODO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SMARTTODO_REGISTRATION=1
SMARTTODO_SCHEDULER=1
# DEV disables optional automatic calls to external AI services.
ENV=DEV
